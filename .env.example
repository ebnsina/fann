# Every variable below is declared in src/env.ts, which is the source of truth.
#
# There are no defaults. Each one must be set or the app refuses to start, which
# is deliberate: a signing secret or a virus scanner that quietly falls back to a
# development value is not noticed until it matters. Copy this file to `.env` and
# fill it in.
#
# NODE_ENV is normally set for you by `pnpm dev` and `pnpm build`. Set it
# yourself when you run the built server: NODE_ENV=production node build

# --- Database (required) ---------------------------------------------------
# Needs the pgcrypto, pg_trgm, vector and unaccent extensions.
# Run `pnpm db:setup` once to install them and apply migrations.
DATABASE_URL="postgres://user:password@localhost:5432/fann"

# --- Storage ---------------------------------------------------------------
# 'local' writes to STORAGE_LOCAL_DIR; 's3' requires the S3_* variables below.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# Signs download links that leave the session. At least 32 characters, and a
# different value in every deployment — generate with: openssl rand -base64 48
STORAGE_SIGNING_SECRET=""

S3_BUCKET=""
S3_REGION=""
# Set for Cloudflare R2 or MinIO; leave empty for AWS.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email -----------------------------------------------------------------
# 'log' prints messages (including verification links) to stdout.
EMAIL_DRIVER="log"
EMAIL_FROM="Fann <noreply@localhost>"
# Required when EMAIL_DRIVER is "resend"; leave empty otherwise.
RESEND_API_KEY=""

# --- Uploads ---------------------------------------------------------------
# "permissive" marks every uploaded file clean WITHOUT scanning it. Development
# only — it must never be this in production.
FILE_SCANNER="permissive"

# Required when FILE_SCANNER is "clamav". Selecting clamav without a host stops
# the app at boot rather than letting it believe it is scanning uploads.
# Locally:
#   docker run -d --name clamav -p 3310:3310 --platform linux/amd64 clamav/clamav
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# A scan that runs over this is recorded as failed, never as clean.
CLAMAV_TIMEOUT_MS="30000"

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for POST /internal/benchmarks, which rebuilds the published pay
# figures. Generate with `openssl rand -base64 48`. Must be at least 32 chars —
# an unguarded endpoint here lets anyone rewrite what the market looks like.
CRON_SECRET=""

# --- AI (optional) ---------------------------------------------------------
# Empty turns every AI feature off, which is a supported way to run this — each
# one has a path that does not need a model, and the UI says plainly when it is
# unavailable rather than hiding the button.
AI_PROVIDER=""
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
