{
	"name": "fann",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --tsconfig e2e/tsconfig.json",
		"db:setup": "tsx scripts/db-extensions.ts && drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1095.0",
		"@fontsource-variable/archivo": "5.3.0",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@hugeicons/core-free-icons": "^4.2.3",
		"@node-rs/argon2": "^2.0.2",
		"@tanstack/ai": "^0.42.0",
		"@tanstack/ai-anthropic": "^0.16.3",
		"@tanstack/ai-openai": "^0.17.1",
		"arctic": "^3.7.0",
		"clsx": "^2.1.1",
		"isomorphic-dompurify": "^3.19.0",
		"marked": "^18.0.7",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.2"
	}
}
